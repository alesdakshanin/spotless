{
	"name": "spotless",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "Find and replace unplayable songs in your Spotify library",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check",
		"format": "biome check --write",
		"check": "tsc --noEmit && biome check && vitest run --coverage"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.5",
		"@tailwindcss/vite": "^4.2.1",
		"@vitest/coverage-v8": "^3.2.4",
		"jsdom": "^28.1.0",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.7.0",
		"vite": "^6.2.0",
		"vitest": "^3.0.0"
	}
}
